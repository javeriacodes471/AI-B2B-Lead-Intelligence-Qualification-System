    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\n\n// -----------------------------\n// BASIC LEAD DATA\n// -----------------------------\n\nconst firstName = lead.firstName || \"\";\nconst lastName = lead.lastName || \"\";\nconst email = String(lead.email || \"\").toLowerCase();\nconst company = lead.company || \"\";\n\nconst service = lead.service || \"\";\nconst budget = lead.budget || \"\";\nconst message = lead.message || \"\";\n\n\n// -----------------------------\n// ENRICHED COMPANY DATA\n// -----------------------------\n\nconst industry =\n  lead.industry ||\n  lead.industries ||\n  \"\";\n\nconst employees = Number(\n  lead.employee_count ||\n  lead.employees ||\n  0\n);\n\nconst country =\n  lead.country ||\n  lead.location ||\n  \"\";\n\nconst website =\n  lead.website ||\n  lead.domain ||\n  \"\";\n\n\n// -----------------------------\n// LEAD SCORING\n// -----------------------------\n\nlet score = 0;\nlet reasons = [];\n\n\n// COMPANY FIT\n\nif (company && company.toLowerCase() !== \"unknown\") {\n  score += 10;\n  reasons.push(\"Company identified\");\n}\n\nif (industry) {\n  score += 10;\n  reasons.push(\"Industry data available\");\n}\n\nif (employees >= 10) {\n  score += 15;\n  reasons.push(\"Established company size\");\n}\n\n\n// PROJECT INTENT\n\nconst intentKeywords = [\n  \"automation\",\n  \"automate\",\n  \"crm\",\n  \"lead generation\",\n  \"workflow\",\n  \"integration\",\n  \"ai\",\n  \"system\"\n];\n\nif (\n  intentKeywords.some(keyword =>\n    service.toLowerCase().includes(keyword) ||\n    message.toLowerCase().includes(keyword)\n  )\n) {\n  score += 20;\n  reasons.push(\"Strong project intent\");\n}\n\nif (message.length >= 100) {\n  score += 10;\n  reasons.push(\"Detailed project requirement\");\n}\n\n\n// BUDGET\n\nconst budgetText = budget.toLowerCase();\n\nif (\n  budgetText.includes(\"5,000\") ||\n  budgetText.includes(\"10,000\") ||\n  budgetText.includes(\"10,000+\")\n) {\n  score += 20;\n  reasons.push(\"High project budget\");\n}\n\nelse if (budgetText.includes(\"1,000\")) {\n  score += 15;\n  reasons.push(\"Qualified project budget\");\n}\n\nelse if (budgetText.includes(\"not sure\")) {\n  score += 5;\n  reasons.push(\"Budget not defined\");\n}\n\n\n// BUSINESS EMAIL\n\nconst personalEmailDomains = [\n  \"gmail.com\",\n  \"yahoo.com\",\n  \"hotmail.com\",\n  \"outlook.com\",\n  \"icloud.com\"\n];\n\nconst isPersonalEmail = personalEmailDomains.some(\n  domain => email.endsWith(\"@\" + domain)\n);\n\nif (email && !isPersonalEmail) {\n  score += 10;\n  reasons.push(\"Business email\");\n}\n\n\n// -----------------------------\n// QUALIFICATION\n// -----------------------------\n\nlet qualification;\n\nif (score >= 70) {\n  qualification = \"Qualified\";\n}\nelse if (score >= 40) {\n  qualification = \"Review\";\n}\nelse {\n  qualification = \"Unqualified\";\n}\n\n\n// -----------------------------\n// CLEAN OUTPUT\n// -----------------------------\n\nreturn {\n  json: {\n    // IMPORTANT: CRM PERSON ID\n    crmPersonId: lead.crmPersonId || \"\",\n\n    firstName,\n    lastName,\n    email,\n    company,\n\n    service,\n    budget,\n    message,\n\n    companyIndustry: industry,\n    companySize: employees || null,\n    companyCountry: country,\n    companyWebsite: website,\n\n    leadScore: score,\n    qualification,\n    scoringReasons: reasons.join(\", \"),\n\n    processedAt: new Date().toISOString()\n  }\n};"
      },
